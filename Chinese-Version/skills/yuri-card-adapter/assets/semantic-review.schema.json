{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_kind": {
      "const": "agent_audit"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "enum": [
              "referent",
              "world_rule",
              "relationship",
              "identity",
              "source_continuity",
              "source_completeness",
              "runtime_delivery",
              "age_scope",
              "evidence",
              "style",
              "other"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "decision",
              "note"
            ]
          },
          "status": {
            "enum": [
              "open",
              "resolved_by_patch",
              "recorded_note"
            ]
          },
          "pointers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(/.*)?$"
            },
            "uniqueItems": true
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "status",
          "pointers",
          "summary",
          "resolution"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "recorded_note"
                }
              }
            },
            "then": {
              "properties": {
                "severity": {
                  "const": "note"
                }
              }
            }
          }
        ]
      }
    },
    "author_acceptance": {
      "const": "pending"
    },
    "import": {
      "const": "not_run"
    },
    "roleplay": {
      "const": "not_run"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "source_sha256",
    "candidate_sha256",
    "review_kind",
    "scope",
    "issues",
    "author_acceptance",
    "import",
    "roleplay"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline semantic issue triage",
  "description": "Candidate-specific agent findings; this record cannot declare human acceptance or runtime success.",
  "allOf": [
    {
      "properties": {
        "issues": {
          "items": {
            "if": {
              "properties": {
                "status": {
                  "const": "resolved_by_patch"
                }
              }
            },
            "then": {
              "properties": {
                "resolution": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  ]
}
