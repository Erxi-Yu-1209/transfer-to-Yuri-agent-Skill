{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "presentation_choice": {
      "enum": [
        "keep",
        "redesign"
      ]
    },
    "presentation_authorization": {
      "type": "string",
      "minLength": 1
    },
    "structure_authorization": {
      "type": "string",
      "minLength": 1
    },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "draft_pointer": {
            "type": "string",
            "minLength": 1
          },
          "expected_value_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "adaptation",
              "creative_opening",
              "presentation"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "pointer",
          "draft_pointer",
          "expected_value_sha256",
          "kind",
          "reason",
          "source_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "draft_sha256",
    "presentation_choice",
    "replacements"
  ],
  "additionalProperties": false
}
