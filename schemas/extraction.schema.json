{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_status": {
      "enum": [
        "pending",
        "agent_reviewed"
      ]
    },
    "reviewed_region_pointers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "character",
              "place",
              "faction",
              "object",
              "concept"
            ]
          },
          "role": {
            "enum": [
              "main",
              "background",
              "player",
              "unknown",
              "not_applicable"
            ]
          },
          "classification_basis": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string",
                  "pattern": "^(/.*)?$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "pointer",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "role",
          "classification_basis",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "identity",
              "motivation",
              "history",
              "world_rule",
              "event",
              "relationship",
              "portrayal",
              "other"
            ]
          },
          "status": {
            "enum": [
              "extracted",
              "inference"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string",
                  "pattern": "^(/.*)?$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "pointer",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "statement",
          "entity_ids",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "from_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "to_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dynamics": {
            "type": "array",
            "items": {
              "enum": [
                "romance",
                "friendship",
                "neutral",
                "rivalry",
                "hostility",
                "kinship",
                "dependence",
                "trust",
                "unknown"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "from_id",
          "to_id",
          "dynamics",
          "claim_ids"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "statement",
          "claim_ids"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "statement",
          "claim_ids"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_pointers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "question",
          "source_pointers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "review_status",
    "reviewed_region_pointers",
    "entities",
    "claims",
    "relationships",
    "constraints",
    "events",
    "unresolved"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded inspection extraction",
  "description": "Structural validation plus exact pointer/quote checks are implemented. Logical entailment and human approval are not automated."
}
