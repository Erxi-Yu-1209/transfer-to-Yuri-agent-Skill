{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "review_status": {
      "enum": [
        "pending",
        "agent_reviewed"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "character",
              "place",
              "faction",
              "object",
              "concept"
            ]
          },
          "role": {
            "enum": [
              "main",
              "background",
              "player",
              "unknown",
              "not_applicable"
            ]
          },
          "gender": {
            "enum": [
              "woman",
              "man",
              "unknown",
              "not_applicable"
            ]
          },
          "nature": {
            "enum": [
              "human",
              "virtual",
              "nonhuman",
              "unknown",
              "not_applicable"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "role",
          "gender",
          "nature",
          "aliases",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "identity",
              "motivation",
              "history",
              "world_rule",
              "event",
              "relationship",
              "portrayal",
              "other"
            ]
          },
          "status": {
            "enum": [
              "extracted",
              "inference"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "asserted_by": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "statement",
          "entity_ids",
          "asserted_by",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "from_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "dynamics": {
            "type": "array",
            "items": {
              "enum": [
                "romance",
                "friendship",
                "neutral",
                "rivalry",
                "hostility",
                "kinship",
                "trust",
                "dependence",
                "unknown"
              ]
            },
            "minItems": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "from_id",
          "to_id",
          "dynamics",
          "outcome",
          "claim_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "statement",
          "claim_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "statement",
          "claim_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "summary",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "review_status",
    "entities",
    "claims",
    "relationships",
    "constraints",
    "events",
    "unresolved"
  ],
  "additionalProperties": false
}
