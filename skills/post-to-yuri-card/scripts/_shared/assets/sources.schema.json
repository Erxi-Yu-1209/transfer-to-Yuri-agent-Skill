{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "post",
              "novel"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "captured_at": {
            "type": "string",
            "minLength": 1
          },
          "original_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text_path": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "coverage": {
            "type": "object"
          },
          "offset_basis": {
            "type": "string",
            "minLength": 1
          },
          "original_bytes_retained": {
            "const": false
          }
        },
        "required": [
          "id",
          "kind",
          "filename",
          "url",
          "captured_at",
          "original_sha256",
          "text_path",
          "text_sha256",
          "coverage",
          "offset_basis",
          "original_bytes_retained"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false
}
